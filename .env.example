# ===== Server =====
PORT=4000
# Set NODE_ENV=production when deployed: disables LAN origins, enables HSTS and strict checks
NODE_ENV=development
# Number of reverse proxies in front of this server (0 = none). Needed for correct client IPs.
TRUST_PROXY=0
# Frontend origin(s) allowed to call this API (comma separated)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
ALLOW_LAN_ORIGINS=true

# ===== Supabase (projet YOUR_PROJECT_REF) =====
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ===== Freda Pay Issuing (https://issuing.fredapay.com/docs) =====
FREDA_API_BASE=https://api.fredapay.com
FREDA_API_KEY=sk_test_...
FREDA_PUBLIC_KEY=pk_test_...
# whsec_... bay lè ou anrejistre URL webhook la (optionnel pour les tests locaux)
FREDA_WEBHOOK_SECRET=whsec_REPLACE_ME

# ===== Règles métier =====
# Fees (card creation, top-up, withdrawal, card, transfer) are in the fee_rules table, editable by an admin.
HTG_PER_USD=131
MIN_DEPOSIT_USD=1
MIN_WITHDRAW_USD=1
MIN_CARD_FUND_USD=1
MIN_CARD_PREFUND_USD=2
# Rolling 24h caps per user in USD (0 = no cap)
DAILY_TRANSFER_LIMIT_USD=2000
DAILY_WITHDRAW_LIMIT_USD=2000
REQUIRE_KYC_FOR_CARDS=true

# ===== Didit identity verification (https://docs.didit.me) =====
DIDIT_API_KEY=REPLACE_ME
DIDIT_WORKFLOW_ID=REPLACE_ME
DIDIT_WEBHOOK_SECRET=REPLACE_ME
FRONTEND_URL=http://localhost:5173

# ===== Step-up authentication + encryption =====
# Public (publishable/anon) key, used only to re-check the user's password before sensitive actions
SUPABASE_ANON_KEY=sb_publishable_...
# AES-256 key for ID numbers. Generate: openssl rand -hex 32. KEEP A BACKUP: losing it makes stored ID numbers unreadable.
DATA_ENCRYPTION_KEY=REPLACE_ME

# Users WITH a verified 2FA (TOTP) factor need a 2FA-verified session (aal2) for every money / personal data / admin action
# (transfers, card funding, deposits, getIdentity, fees...). Users without 2FA are not affected, except admins, who must have 2FA.
# The API answers HTTP 403 with {"error":{"code":"MFA_REQUIRED"}} and the web app prompts for the code and retries.
# Defaults to true when unset. Set to "false" only to switch it off temporarily.
ENFORCE_MFA_ALL=true

# ===== Web Push (morning greeting + a push for every transaction event) =====
# Generate with: npm run vapid:generate (prints the three lines; nothing is written to disk). Leave empty to disable push.
# Rotating the keys invalidates every existing subscription: users must re-enable notifications in the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-domain.example
